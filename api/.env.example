# Copy this file to .env and adjust. .env is ignored by git.
APP_DEBUG=0

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=tarini
DB_USER=root
DB_PASS=

# Where uploaded images are stored on disk (default: <project>/uploads)
# UPLOADS_DIR=C:/xampp/htdocs/ckg/jewellery/uploads
# Public URL prefix for uploaded images. Use /uploads when the site and API share one domain.
UPLOADS_URL=/uploads
MAX_UPLOAD_MB=5

# Minimum admin password length (default 10; below 8 the letter+number rule is skipped). Keep 10+ in production.
# MIN_PASSWORD_LENGTH=10

# LOCAL DEVELOPMENT ONLY. Never enable on a public website (default 0 = secure password_hash).
ALLOW_PLAINTEXT_PASSWORDS=0
# APP_ENV=production
